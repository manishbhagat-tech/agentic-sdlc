{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["story_id", "skill", "outcome"],
  "properties": {
    "story_id": { "type": "string" },
    "revision": { "type": ["string", "number"] },
    "skill": {
      "type": "string",
      "enum": [
        "feature-prd",
        "feature-hld",
        "feature-lld",
        "feature-ui",
        "feature-stories",
        "story-implement",
        "story-fix",
        "story-test",
        "story-security",
        "ui-review",
        "story-review",
        "story-cleanup",
        "git-ops",
        "devops",
        "story-ready",
        "story-author",
        "bootstrap"
      ]
    },
    "pack_tokens_est": { "type": "integer" },
    "files_read": { "type": "integer" },
    "files_edited": { "type": "integer" },
    "paths_outside_allow": { "type": "integer" },
    "skills_declared": {
      "type": "array",
      "items": { "type": "string" }
    },
    "skills_invoked": {
      "type": "array",
      "items": { "type": "string" }
    },
    "security": { "type": "string" },
    "cleanup_ran": { "type": "boolean" },
    "tests_passed": { "type": "boolean" },
    "outcome": { "type": "string", "enum": ["pass", "fail", "abort"] }
  }
}
